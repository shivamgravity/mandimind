# .streamlit/secrets.toml
# Copy this file and fill in your real keys for Streamlit Cloud deployment.
# In Streamlit Cloud: go to App Settings → Secrets and paste these key=value pairs.

DATA_GOV_API_KEY = "your_data_gov_api_key_here"
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMMA_MODEL = "gemma-4-26b-a4b-it"
TRANSPORT_RATE_PER_QUINTAL_KM = "0.6"
DEFAULT_SEARCH_RADIUS_KM = "150"
