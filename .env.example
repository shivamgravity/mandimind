# Government of India Open Data API key
DATA_GOV_API_KEY=

# Google GenAI API key (for Gemma 4 via Google AI Studio)
GEMINI_API_KEY=

# Gemma model to use
GEMMA_MODEL=gemma-4-26b-a4b-it

# Transport cost assumption (₹ per quintal per km)
TRANSPORT_RATE_PER_QUINTAL_KM=0.6

# Default search radius (km) when no local market found
DEFAULT_SEARCH_RADIUS_KM=150
